# Obsidian SSH Sync — Signaling Server configuration
# Copy this file to .env and fill with your values

# URL of your Cloudflare Worker signaling server
OBSIDIANSSH_SIGNALING_URL=https://obsidianssh-signaling.YOUR_SUBDOMAIN.workers.dev

# Bearer token configured on the Worker (wrangler secret put SIGNALING_TOKEN)
OBSIDIANSSH_SIGNALING_TOKEN=obsidianssh-sync-v1-public
